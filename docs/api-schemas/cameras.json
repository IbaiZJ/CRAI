{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "/cameras",
  "description": "Camera collection endpoints",
  "get": {
    "description": "List cameras",
    "response": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "location": { "type": "string" },
          "status": { "type": "string" }
        },
        "required": ["id"]
      }
    }
  }
}
