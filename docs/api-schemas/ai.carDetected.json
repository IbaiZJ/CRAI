{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "/ai/carDetected",
  "description": "AI webhook when a car is detected",
  "post": {
    "description": "Webhook from AI service",
    "request": {
      "type": "object",
      "properties": {
        "plate": { "type": "string" },
        "cameraId": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "imageUrl": { "type": "string", "format": "uri" }
      },
      "required": ["plate", "cameraId", "timestamp"]
    },
    "response": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "detectionId": { "type": "integer" }
      }
    }
  }
}
