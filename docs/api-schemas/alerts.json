{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "/alerts",
  "description": "Alert ingestion endpoint",
  "post": {
    "description": "Create an alert",
    "request": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "cameraId": { "type": "integer" },
        "severity": { "type": "string", "enum": ["low","medium","high"] }
      },
      "required": ["type","message"]
    }
  }
}
