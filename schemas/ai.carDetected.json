{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "/ai/carDetected",
  "description": "AI webhook called when a car is detected",
  "post": {
    "description": "AI detection payload",
    "request": {
      "type": "object",
      "properties": {
        "vehicleId": { "type": "string" },
        "cameraId": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number" },
        "image": { "type": "string", "format": "uri" },
        "meta": { "type": "object" }
      },
      "required": ["vehicleId", "cameraId", "timestamp"]
    }
  }
}
