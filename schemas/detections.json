{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "/detections",
  "description": "Detections collection",
  "$defs": {
    "Detection": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "vehicleId": { "type": "string" },
        "cameraId": { "type": "integer" },
        "detectionDate": { "type": "string", "format": "date-time" },
        "itvStatus": { "type": "string", "enum": ["valid", "expired", "expiring_soon"] }
      },
      "required": ["vehicleId", "cameraId", "detectionDate"]
    }
  },
  "get": {
    "description": "List detections",
    "response": {
      "type": "array",
      "items": { "$ref": "#/ $defs/Detection" }
    }
  },
  "post": {
    "description": "Create a detection (AI webhook)",
    "request": {
      "type": "object",
      "properties": {
        "vehicleId": { "type": "string" },
        "cameraId": { "type": "integer" },
        "detectionDate": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number" },
        "imageUrl": { "type": "string", "format": "uri" }
      },
      "required": ["vehicleId", "cameraId", "detectionDate"]
    }
  }
}
