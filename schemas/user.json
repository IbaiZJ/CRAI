{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "user.json",
  "$defs": {
    "User": {
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "name": { "type": "string" },
        "surname": { "type": "string" }
      },
      "required": ["username", "password"]
    }
  }
}
