      "key": "baseUrl",
      "value": "http://localhost:6903",
      "type": "string"
    },
    {
      "key": "ebApiBaseUrl",
      "value": "http://localhost:8001",
      "type": "string"
    },
    {
      "key": "itvApiBaseUrl",
      "value": "http://localhost:8002",
      "type": "string"
    }
