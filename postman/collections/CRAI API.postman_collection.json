              "query": [
                {
                  "key": "carPlate",
                  "value": "1234ABC",
                  "description": "The car plate number to look up"
                }
              ]
            },
            "description": "Retrieves the ITV inspection date for a given car plate number (detect_plate function)"
          }
        }
      ]
    },
