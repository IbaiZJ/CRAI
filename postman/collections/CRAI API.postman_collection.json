  "item": [
    {
      "name": "Environmental Badge API",
      "description": "Endpoints for retrieving environmental badge information by car plate",
      "item": [
        {
          "name": "Get Badge by Car Plate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ebApiBaseUrl}}/api?carPlate=1234ABC",
              "host": ["{{ebApiBaseUrl}}"],
              "path": ["api"],
              "query": [
                {
                  "key": "carPlate",
                  "value": "1234ABC",
                  "description": "The car plate number to look up"
                }
              ]
            },
            "description": "Retrieves the environmental badge for a given car plate number (detect_plate function)"
          }
        }
      ]
    },
    {
      "name": "ITV API",
