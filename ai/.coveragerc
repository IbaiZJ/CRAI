[run]
source = .
omit = 
    */app_ui.py
    */main.py
    */*_demo.py
    */tests/*
    */__pycache__/*
    */site-packages/*
    */notebooks/*
    */logs/*
    */captures/*
    */models/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
