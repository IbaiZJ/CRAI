[run]
source = src
relative_files = True
omit = 
    src/app_ui.py
    src/main.py
    src/video/_*_demo.py
    */tests/*
    */__pycache__/*
    */site-packages/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
