{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PoliceMessage",
  "type": "object",
  "required": ["type", "plate", "description"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["ITV", "POLICE", "BADGE"]
    },
    "plate": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "recipientEmail": {
      "type": ["string", "null"]
    },
    "chatId": {
      "type": ["number", "string", "null"]
    }
  },
  "additionalProperties": true
}
