@startuml Class
title CRAI OS - Class Diagram (Simulation and Queues)

package config {
  class SimulationConfig {
    -cameraCount : int
    -vehiclesPerCycle : int
    -vehicleIntervalMs : int
    -ocrDelayMs : int
    -cameraQueueCapacity : int
    -policeQueueCapacity : int
    -stolenProbability : double
    -itvFailProbability : double
    -nodeRedWebhookUrl : String
    +getCameraCount()
    +getVehiclesPerCycle()
    +getVehicleIntervalMs()
    +getOcrDelayMs()
    +getCameraQueueCapacity()
    +getPoliceQueueCapacity()
    +getStolenProbability()
    +getItvFailProbability()
    +getNodeRedWebhookUrl()
    +setCameraCount(int)
    +setVehiclesPerCycle(int)
    +setVehicleIntervalMs(int)
    +setOcrDelayMs(int)
    +setStolenProbability(double)
    +setItvFailProbability(double)
    +setNodeRedWebhookUrl(String)
  }
  class AppConfig
}

package controller {
  class SimulationController {
    +start()
    +stop()
    +status()
  }
  class ControlController {
    +setDelay(int)
    +setStealProb(double)
    +setItvProb(double)
    +status()
    +updateCameras(int)
    +setVehiclesPerCycle(int)
    +setInterval(int)
    +updateSim(Map)
  }
  class VehicleController {
    +sendVehicle(Vehicle)
  }
  class CameraController {
    +status()
  }
  class PoliceController {
    +getAlerts()
    +clearAlerts()
  }
}

package model {
  class Vehicle {
    -plate : String
    -priority : int
    -alertVehicle : boolean
    -envTag : String
    -stolen : boolean
    -itvFail : boolean
    +getPlate()
    +getPriority()
    +isAlertVehicle()
    +getEnvTag()
    +isStolen()
    +compareTo(Vehicle)
    +hasItvFail()
    +setItvFail(boolean)
  }
  class PoliceMessage {
    -type : AlertType
    -plate : String
    -description : String
    -recipientEmail : String
    +getType()
    +getPlate()
    +getDescription()
    +getRecipientEmail()
    +setRecipientEmail(String)
  }
  class PoliceMessageFactory {
    +build(AlertType,String,String)
    +build(AlertType,String,String,String)
  }
  class ITVRecord {
    -plate : String
    -expirationTimestamp : long
    +isExpired()
    +getExpirationTimestamp()
    +getPlate()
  }
  class ITVStatus
  class AlertType
  class Owner {
    -plate : String
    -email : String
    -name : String
    +getPlate()
    +getEmail()
    +getName()
  }
  class SimulationState {
    -running : boolean
    +isRunning()
    +setRunning(boolean)
  }
}

package repository {
  class ITVRepository {
    +find(String)
    +save(ITVRecord)
    +exists(String)
  }
  class OwnerRepository {
    +findByPlate(String)
    +save(Owner)
  }
}

package service {
  class SimulationService {
    +startSimulation()
    +stopSimulation()
    +isRunning()
    +getStatus()
  }
  class VehicleSpawnerService {
    +spawnVehicle()
  }
  class CameraPoolService {
    +enqueueVehicle(Vehicle)
    +resizeCameraPool(int)
    +getStatus()
  }
  class ITVService {
    +check(String)
    +preloadItvDatabase()
  }
  class PoliceService {
    +sendAlert(PoliceMessage)
    +getProcessedAlerts()
    +clearAlerts()
  }
}

package utils {
  class BoundedPriorityBlockingQueue<E> {
    +put(E)
    +take() : E
    +size() : int
  }
  class RandomVehicleGenerator {
    +generate(double,double) : Vehicle
  }
  class SpanishPlateGenerator {
    +generate() : String
  }
}

class "LinkedBlockingQueue<PoliceMessage>" as PoliceQueue <<java.util.concurrent>>

SimulationController --> SimulationService
ControlController --> SimulationConfig
ControlController --> CameraPoolService
VehicleController --> CameraPoolService
CameraController --> CameraPoolService
PoliceController --> PoliceService

SimulationService --> SimulationState

VehicleSpawnerService --> SimulationConfig
VehicleSpawnerService --> SimulationService
VehicleSpawnerService --> CameraPoolService : enqueue(Vehicle)
VehicleSpawnerService --> RandomVehicleGenerator : generate()

CameraPoolService --> SimulationConfig
CameraPoolService --> ITVService
CameraPoolService --> OwnerRepository
CameraPoolService --> PoliceService : sendAlert(PoliceMessage)
CameraPoolService --> BoundedPriorityBlockingQueue : queue<Vehicle>
CameraPoolService --> PoliceMessageFactory

ITVService --> ITVRepository
ITVService --> SimulationConfig

PoliceService --> SimulationConfig
PoliceService --> PoliceMessage
PoliceService --> PoliceQueue : queue<PoliceMessage>

ITVRepository --> ITVRecord
OwnerRepository --> Owner
PoliceMessageFactory --> PoliceMessage
RandomVehicleGenerator --> SpanishPlateGenerator
SpanishPlateGenerator --> Vehicle : plate()

note right of RandomVehicleGenerator
  Priority rule:
  3 stolen or alert
  2 itv fail
  1 invalid env tag
  0 normal
end note

note bottom
  Camera queue: bounded priority queue (capacity from SimulationConfig.cameraQueueCapacity).
  Police queue: bounded LinkedBlockingQueue (capacity from SimulationConfig.policeQueueCapacity).
end note

@enduml
