@startuml Sequence
title Sequence diagram (CRAI os)
actor "VehicleSpawnerService" as Spawner
participant "RandomVehicleGenerator" as Generator
participant "CameraQueue\n(BoundedPriorityBlockingQueue)" as Queue
participant "CameraWorker\n(CameraPoolService)" as Camera
participant "ITVService" as ITV
participant "PoliceService" as Police
participant "PoliceQueue\n(LinkedBlockingQueue)" as PoliceQueue
participant "Node-RED\n(Webhook)" as NodeRed

Spawner -> Generator : generate(stolenProb, itvFailProb)
Generator --> Spawner : Vehicle(priority)
Spawner -> Queue : put(Vehicle)
loop Por cada camara activa
  Queue -> Camera : take()
  Camera -> Camera : validar etiqueta ambiental
  Camera -> ITV : check(plate)
  ITV --> Camera : status
  Camera -> Camera : check stolen/alert
  Camera -> Police : sendAlert(PoliceMessage)
  alt alerta generada
    Police -> PoliceQueue : put(PoliceMessage)
    Police -> Police : procesar mensaje
    opt webhook configurado
      Police -> NodeRed : HTTP POST (alerta)
    end
  end
end
@enduml
