@startuml UseCase
title CRAI Simulation - Casos de uso
actor Operador as Op
actor "Sistema externo\n(Node-RED / Postman)" as Ext
actor Policia as Pol

rectangle "CRAI Simulation" {
  usecase "Arrancar simulación" as UC_Start
  usecase "Detener simulación" as UC_Stop
  usecase "Consultar estado" as UC_Status
  usecase "Ajustar parámetros\n(cámaras, intervalos,\nprobabilidades)" as UC_Admin
  usecase "Enviar vehículo manual" as UC_Send
  usecase "Recibir alertas\n(policiales/ITV/ambiental)" as UC_Alerts
}

Op --> UC_Start
Op --> UC_Stop
Op --> UC_Status
Op --> UC_Admin
Op --> UC_Send
Pol --> UC_Alerts
Ext --> UC_Send
UC_Alerts --> Ext : Webhook Node-RED
@enduml