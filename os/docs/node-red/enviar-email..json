[
  {
    "id": "http-in",
    "type": "http in",
    "z": "flow",
    "name": "POST /alerts",
    "url": "/alerts",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 140,
    "y": 120,
    "wires": [["json"]]
  },
  {
    "id": "json",
    "type": "json",
    "z": "flow",
    "name": "Parse JSON",
    "property": "payload",
    "action": "",
    "pretty": false,
    "x": 320,
    "y": 120,
    "wires": [["switch-type"]]
  },
  {
    "id": "switch-type",
    "type": "switch",
    "z": "flow",
    "name": "type",
    "property": "payload.type",
    "propertyType": "msg",
    "rules": [
      { "t": "eq", "v": "ITV", "vt": "str" },
      { "t": "eq", "v": "POLICE", "vt": "str" },
      { "t": "else" }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 3,
    "x": 490,
    "y": 120,
    "wires": [["func-itv-email", "func-itv-telegram"], ["func-police-telegram"], ["debug-other"]]
  },
  {
    "id": "func-itv-email",
    "type": "function",
    "z": "flow",
    "name": "Build email",
    "func": "const p = msg.payload;\nif (!p.recipientEmail) {\n    node.warn('No recipientEmail for plate ' + p.plate);\n    return null;\n}\nmsg.to = p.recipientEmail;\nmsg.topic = `Aviso ITV ${p.plate}`;\nmsg.payload = `Estado ITV: ${p.message}\\nMatricula: ${p.plate}\\nPrioridad: ${p.priority ?? ''}`;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 720,
    "y": 80,
    "wires": [["email"]]
  },
  {
    "id": "func-itv-telegram",
    "type": "function",
    "z": "flow",
    "name": "Build Telegram (ITV)",
    "func": "const p = msg.payload;\nmsg.payload = `ITV ALERTA\\nMatricula: ${p.plate}\\nMensaje: ${p.message}`;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 730,
    "y": 140,
    "wires": [["telegram"]]
  },
  {
    "id": "func-police-telegram",
    "type": "function",
    "z": "flow",
    "name": "Build Telegram (POLICE)",
    "func": "const p = msg.payload;\nmsg.payload = `ALERTA POLICIA\\nMatricula: ${p.plate}\\nMensaje: ${p.message}`;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 730,
    "y": 200,
    "wires": [["telegram"]]
  },
  {
    "id": "email",
    "type": "e-mail",
    "z": "flow",
    "server": "smtp.tu-proveedor.com",
    "port": "587",
    "secure": false,
    "name": "SMTP",
    "dname": "Send email",
    "x": 960,
    "y": 80,
    "wires": []
  },
  {
    "id": "telegram",
    "type": "telegram sender",
    "z": "flow",
    "name": "Telegram alerts",
    "bot": "YOUR_TELEGRAM_BOT",
    "haserroroutput": false,
    "outputs": 1,
    "x": 960,
    "y": 170,
    "wires": [[]]
  },
  {
    "id": "debug-other",
    "type": "debug",
    "z": "flow",
    "name": "Other alerts",
    "active": true,
    "tosidebar": true,
    "console": false,
    "complete": "payload",
    "x": 720,
    "y": 260,
    "wires": []
  },
  {
    "id": "http-resp",
    "type": "http response",
    "z": "flow",
    "name": "HTTP 200",
    "statusCode": "",
    "headers": {},
    "x": 730,
    "y": 320,
    "wires": []
  }
]
