    {
        "id": "n3",
        "type": "function",
        "z": "7eb6aa7336c6b824",
        "name": "Format Telegram Message",
        "func": "// El payload que llega desde Spring Boot\nconst alert = msg.payload || {};\n\n// Campos enviados desde PoliceMessage en Java\nconst type = alert.type || \"UNKNOWN\";\nconst plate = alert.plate || \"UNKNOWN\";\nconst description = alert.description || \"\";  // 👈 AQUÍ CAPTURAMOS EL MENSAJE REAL\n\n// Texto que se enviará a Telegram\nconst text =\n    `🚨 *POLICE ALERT* 🚨\\n\\n` +\n    `*Type:* ${type}\\n` +\n    `*Plate:* ${plate}\\n` +\n    (description ? `*Details:* ${description}` : \"\"); // 👈 SE MUESTRA EL MENSAJE REAL\n\n// Formato para Telegram\nmsg.payload = {\n    chatId: 1143392395,\n    type: \"message\",\n    content: text,\n    options: { parse_mode: \"Markdown\" }\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 280,
        "wires": [
