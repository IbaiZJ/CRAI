@startuml State

skinparam shadowing false

state "Simulation lifecycle" as Sim {
  [*] --> Stopped
  Stopped --> Running : start
  Running --> Stopped : stop
}

state "Vehicle lifecycle" as Veh {
  [*] --> Created
  Created --> Queued : enqueued
  Queued --> Processing : camera available
  Processing --> Alerted : violation detected
  Processing --> Completed : no violation
  Alerted --> Completed
  Completed --> [*]
}

state "Alert lifecycle" as Alt {
  [*] --> Created
  Created --> Queued : sendAlert
  Queued --> Sent : worker POST ok
  Queued --> Delivered : no webhook configured
  Queued --> Failed : POST error
  Failed --> Queued : retry on next poll
  Sent --> [*]
  Delivered --> [*]
}

@enduml
