    {
        "id": "63b140e5befc811a",
        "type": "function",
        "z": "01df77f7ae4c4f86",
        "name": "Change parameters",
        "func": "msg.headers = { \"Content-Type\": \"application/json\" };\n\nconst defaults = {\n  cameraCount: 3,\n  stolenProbability: 0.05,\n  itvFailProbability: 0.30,\n  vehiclesPerCycle: 1,\n  vehicleIntervalMs: 2000,\n  ocrDelayMs: 200\n};\n\n// toma valor de msg.<k> si viene del inject, si no el último en flow, si no el default\n[\"cameraCount\",\"stolenProbability\",\"itvFailProbability\",\"vehiclesPerCycle\",\"vehicleIntervalMs\",\"ocrDelayMs\"]\n  .forEach(k => {\n    if (msg[k] !== undefined) flow.set(k, msg[k]);\n  });\n\nmsg.payload = {\n  cameraCount: flow.get(\"cameraCount\") ?? defaults.cameraCount,\n  stolenProbability: flow.get(\"stolenProbability\") ?? defaults.stolenProbability,\n  itvFailProbability: flow.get(\"itvFailProbability\") ?? defaults.itvFailProbability,\n  vehiclesPerCycle: flow.get(\"vehiclesPerCycle\") ?? defaults.vehiclesPerCycle,\n  vehicleIntervalMs: flow.get(\"vehicleIntervalMs\") ?? defaults.vehicleIntervalMs,\n  ocrDelayMs: flow.get(\"ocrDelayMs\") ?? defaults.ocrDelayMs\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 220,
        "wires": [
