    {
        "id": "ad2056838a786431",
        "type": "function",
        "z": "b8eced2c956132a8",
        "name": "Validar vehículo (PUT)",
        "func": "const { matricula, impactoAmbiental, autorizado } = msg.payload;\n\nif (!matricula || matricula.trim() === \"\") {\n    msg.statusCode = 400;\n    msg.payload = { error: \"El campo 'matricula' es obligatorio.\" };\n    msg.route = \"error\";\n    return msg;\n}\n\nconst etiquetasValidas = [\"A\", \"B\", \"C\", \"0\", \"ECO\"];\n\nif (!etiquetasValidas.includes(impactoAmbiental)) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"impactoAmbiental debe ser A, B, C, 0 o ECO.\" };\n    msg.route = \"error\";\n    return msg;\n}\n\nif (typeof autorizado !== \"boolean\") {\n    msg.statusCode = 400;\n    msg.payload = { error: \"El campo 'autorizado' debe ser true o false.\" };\n    msg.route = \"error\";\n    return msg;\n}\n\nmsg.route = \"ok\";\nreturn msg;",
        "outputs": 1,
        "x": 520,
        "y": 400,
        "wires": [
            [
                "7fdccf1afd97fdcc"
            ]
        ]
    },
    {
        "id": "7fdccf1afd97fdcc",
        "type": "switch",
        "z": "b8eced2c956132a8",
        "name": "¿OK o ERROR?",
