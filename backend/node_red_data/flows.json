    {
        "id": "b010632ce9ea2afd",
        "type": "function",
        "z": "01df77f7ae4c4f86",
        "name": "Build email",
        "func": "const p = msg.payload;\nconst to = p.recipientEmail || \"u0400412775@gmail.com\";\nmsg.to = to;\nmsg.topic = `🚗 Aviso ITV • ${p.plate}`;\nmsg.payload =\n    `Hello,\n\nWe have updates about your vehicle ${p.plate}:\n\n• ITV status: ${p.description}\n• License plate: ${p.plate}\n• Date: ${new Date().toLocaleString()}\n\nIf your ITV has expired or is about to expire, book an appointment as soon as possible to avoid fines and ensure your safety.\n\nThanks,\nCRAI Team`;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 910,
        "y": 1020,
        "wires": [
            [
                "5e22649949e1823c",
                "5ecdb5ab132aad75"
            ]
        ]
