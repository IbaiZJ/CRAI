        ]
    },
    {
        "id": "a1f0b1e9d1c00102",
        "type": "json",
        "z": "3bf36f2bd537dee3",
        "name": "Parse JSON",
        "property": "payload",
        "action": "obj",
        "pretty": false,
        "x": 370,
        "y": 500,
        "wires": [
            [
                "a1f0b1e9d1c00103"
            ]
        ]
    },
    {
        "id": "a1f0b1e9d1c00103",
        "type": "function",
        "z": "3bf36f2bd537dee3",
        "name": "Validate plate schema",
        "func": "// Schema + Spanish plate validation\nconst payload = msg.payload;\n\nconst requiredFields = [\n    \"plate\",\n    \"confidence\",\n    \"vehicle_type\",\n    \"timestamp\",\n    \"retries\"\n];\n\nfunction error(message) {\n    msg.statusCode = 400;\n    msg.payload = {\n        error: \"Invalid payload\",\n        message\n    };\n    return [null, msg];\n}\n\n// Required fields\nfor (const field of requiredFields) {\n    if (!(field in payload)) {\n        return error(`Missing field: ${field}`);\n    }\n}\n\n// Plate\nif (typeof payload.plate !== \"string\") {\n    return error(\"plate must be a string\");\n}\n\npayload.plate = payload.plate.toUpperCase();\nconst plateRegex = /^[0-9]{4}[B-DF-HJ-NP-TV-Z]{3}$/;\nif (!plateRegex.test(payload.plate)) {\n    return error(\"plate format must be 4 digits followed by 3 consonant letters (Spanish format)\");\n}\n\n// Confidence\nif (typeof payload.confidence !== \"number\" || payload.confidence < 0 || payload.confidence > 1) {\n    return error(\"confidence must be a number between 0 and 1\");\n}\n\n// Vehicle type\nif (typeof payload.vehicle_type !== \"string\") {\n    return error(\"vehicle_type must be a string\");\n}\n\n// Retries\nif (typeof payload.retries !== \"number\" || payload.retries < 0) {\n    return error(\"retries must be a non-negative number\");\n}\n\n// Timestamp\nif (isNaN(Date.parse(payload.timestamp))) {\n    return error(\"timestamp must be a valid ISO-8601 date\");\n}\n\n// OK\nreturn [msg, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 500,
        "wires": [
            [
                "a1f0b1e9d1c00104",
                "4f3b50fb6d090649"
            ],
            [
                "a1f0b1e9d1c00105"
            ]
        ]
    },
    {
        "id": "a1f0b1e9d1c00104",
        "type": "function",
        "z": "3bf36f2bd537dee3",
        "name": "OK response",
        "func": "msg.statusCode = 200;\nmsg.payload = {\n    ok: true,\n    message: \"Plate received and validated\",\n    plate: msg.payload.plate\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 840,
