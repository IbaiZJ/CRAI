    {
        "id": "bf664aedaff28244",
        "type": "function",
        "z": "ba5cb54d469c6c3e",
        "name": "build request",
        "func": "msg.topic = `\nSELECT CASE WHEN EXISTS (\n    SELECT 1 \n    FROM stolenVehicle\n    WHERE plate = ?\n) THEN 1 ELSE 0 END as exist\n`;\nmsg.payload = [msg.carPlate];\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 250,
        "y": 120,
