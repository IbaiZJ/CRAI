                "a1f0b1e9d1c00105"
            ]
        ]
    },
    {
        "id": "a1f0b1e9d1c00104",
        "type": "function",
        "z": "3bf36f2bd537dee3",
        "name": "OK response",
        "func": "msg.statusCode = 200;\nmsg.payload = {\n    ok: true,\n    message: \"Plate received and validated\",\n    plate: msg.payload.plate\n};\nreturn msg;",
        "outputs": 1,
