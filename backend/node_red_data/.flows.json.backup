    {
        "id": "b010632ce9ea2afd",
        "type": "function",
        "z": "01df77f7ae4c4f86",
        "name": "Build email",
        "func": "const p = msg.payload;\nconst to = p.recipientEmail || \"u0400412775@gmail.com\";\nmsg.to = to;\nmsg.topic = `🚗 Aviso ITV • ${p.plate}`;\nmsg.payload =\n    `Hello,\n\nWe have updates about your vehicle ${p.plate}:\n\n• ITV status: ${p.description}\n• License plate: ${p.plate}\n• Date: ${new Date().toLocaleString()}\n\nIf your ITV has expired or is about to expire, book an appointment as soon as possible to avoid fines and ensure your safety.\n\nThanks,\nCRAI Team`;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1250,
        "y": 1040,
        "wires": [
            [
                "5e22649949e1823c",
                "5ecdb5ab132aad75"
            ]
        ]
    },
    {
        "id": "77b28f5d31012cb5",
        "type": "function",
        "z": "01df77f7ae4c4f86",
        "name": "Build Telegram (ITV)",
        "func": "const p = msg.payload;\nconst chatId = p.chatId || 1143392395;\nmsg.payload = {\n    chatId,\n    type: 'message',\n    content: `🚦 ITV Notice\\n\\nLicense plate: ${p.plate}\\nStatus: ${p.description}\\n\\nIf it has expired or is close to expiring, book an appointment as soon as possible.`\n};\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1300,
        "y": 940,
        "wires": [
            [
                "083d998fbb5dde7a"
            ]
        ]
    },
    {
        "id": "6309be18cf01aebf",
        "type": "function",
        "z": "01df77f7ae4c4f86",
