    {
        "id": "9b5bc8b0aef1ebdc",
        "type": "debug",
        "z": "subflow1",
        "name": "db status log",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 1210,
        "y": 380,
        "wires": []
    },
    {
        "id": "5b644b82a17ab94a",
        "type": "function",
        "z": "subflow1",
        "name": "Log DB Status",
        "func": "const statusInfo = {\n    node: msg.status.source.name || 'mysql',\n    state: msg.status.text,\n    fill: msg.status.fill,\n    shape: msg.status.shape,\n    timestamp: new Date().toISOString()\n};\n\nif (msg.status.fill === 'red') {\n    node.error(JSON.stringify(statusInfo));\n} else if (msg.status.fill === 'yellow') {\n    node.warn(JSON.stringify(statusInfo));\n} else {\n    node.log(JSON.stringify(statusInfo));\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1000,
        "y": 380,
        "wires": [
            [
                "9b5bc8b0aef1ebdc"
            ]
        ]
    },
    {
        "id": "cb7d7b5278f27f91",
        "type": "function",
        "z": "subflow1",
        "name": "prepare params",
        "func": "if (msg.params) {\n    msg.payload = msg.params;\n    delete msg.params;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1060,
        "y": 180,
        "wires": [
            [
                "sf_mysql"
            ]
        ]
    },
