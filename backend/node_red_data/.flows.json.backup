    {
        "id": "f4e2b1b9c8a9d3e1",
        "type": "function",
        "z": "01df77f7ae4c4f86",
        "name": "Validate Alert Schema",
        "func": "const schema = {\n    type: \"object\",\n    required: [\"type\", \"plate\", \"description\"],\n    properties: {\n        type: { type: \"string\", enum: [\"ITV\", \"POLICE\", \"BADGE\"] },\n        plate: { type: \"string\" },\n        description: { type: \"string\" },\n        recipientEmail: { type: [\"string\", \"null\"] },\n        chatId: { type: [\"number\", \"string\", \"null\"] }\n    }\n};\n\nconst p = msg.payload || {};\nconst errors = [];\n\nschema.required.forEach((key) => {\n    if (p[key] === undefined) errors.push(`Missing required field: ${key}`);\n});\n\nif (p.type !== undefined && !schema.properties.type.enum.includes(p.type)) {\n    errors.push(`Invalid type: ${p.type}`);\n}\n\n[\"plate\", \"description\"].forEach((key) => {\n    if (p[key] !== undefined && typeof p[key] !== \"string\") {\n        errors.push(`Field ${key} must be a string`);\n    }\n});\n\nif (p.recipientEmail !== undefined && p.recipientEmail !== null && typeof p.recipientEmail !== \"string\") {\n    errors.push(\"recipientEmail must be string or null\");\n}\n\nif (p.chatId !== undefined && p.chatId !== null && typeof p.chatId !== \"number\" && typeof p.chatId !== \"string\") {\n    errors.push(\"chatId must be number, string, or null\");\n}\n\nif (errors.length > 0) {\n    msg.payload = { error: \"Schema validation failed\", details: errors, received: p };\n    return [null, msg];\n}\n\nreturn [msg, null];\n",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 1020,
        "wires": [
            [
                "3280259e0b919d43"
            ],
            [
                "a2f0f51f7d2a4c3e"
            ]
        ]
    },
