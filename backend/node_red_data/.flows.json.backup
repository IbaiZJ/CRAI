            ]
        ]
    },
    {
        "id": "d7eeceba9b69308b",
        "type": "function",
        "z": "ba5cb54d469c6c3e",
        "name": "format data",
        "func": "msg.payload.data = msg.payload.data?.[0]?.exist ?? null\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 120,
        "wires": [
