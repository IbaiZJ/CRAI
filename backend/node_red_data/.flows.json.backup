    },
    {
        "id": "419fc3604bb7203c",
        "type": "function",
        "z": "c67015360647838b",
        "name": "Validate",
        "func": "let plate = msg.carPlate;\n\nif (!plate || typeof plate !== 'string') {\n    msg.payload = null;\n    return msg;\n}\n\nlet formattedPlate = plate.toUpperCase().replace(/\\s/g, '').replace(/-/g, '');\n\nlet regex = /^\\d{4}[BCDFGHJKLMNPRSTVWXYZ]{3}$/;\n\nif (regex.test(formattedPlate)) {\n    msg.payload = formattedPlate;\n} else {\n    msg.payload = null;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 160,
        "wires": [
            [
                "657dd476bf3abcd6"
            ]
        ]
    },
