    {
        "id": "sf_check_retry",
        "type": "function",
        "z": "subflow1",
        "name": "check retry",
        "func": "msg.retryCount = (msg.retryCount || 0) + 1;\nconst maxRetries = msg.maxRetries || 3;\n\nnode.warn(`Try ${msg.retryCount}/${maxRetries} - Error: ${msg.error.message}`);\n\nif (msg.retryCount <= maxRetries) {\n    node.status({fill: \"yellow\", shape: \"ring\", text: `Reintento ${msg.retryCount}`});\n    return [msg, null];\n} else {\n    node.status({fill: \"red\", shape: \"dot\", text: \"Max reintentos\"});\n    \n    msg.payload = {\n        success: false,\n        error: \"Database temporarily unavailable\",\n        message: msg.error.message,\n        attempts: msg.retryCount,\n        timestamp: new Date().toISOString()\n    };\n    msg.statusCode = 503;\n    msg.headers = {\n        \"Content-Type\": \"application/json\",\n        \"Retry-After\": \"60\"\n    };\n    \n    return [null, msg];\n}",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1110,
        "y": 280,
        "wires": [
            [
                "2424b0de5f73a073"
            ],
            []
        ]
    },
    {
        "id": "sf_format_success",
        "type": "function",
        "z": "subflow1",
        "name": "format success",
        "func": "msg.payload = {\n    success: true,\n    data: msg.payload,\n    count: Array.isArray(msg.payload) ? msg.payload.length : 1,\n    timestamp: new Date().toISOString()\n};\n\nmsg.statusCode = 200;\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1400,
        "y": 220,
        "wires": [
            []
        ]
    },
