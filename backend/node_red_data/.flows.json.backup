        "z": "e4c4b244ac7b2ae0",
        "name": "check retry",
        "func": "msg.retryCount = (msg.retryCount || 0) + 1;\nconst maxRetries = msg.maxRetries || 3;\n\nnode.warn(`Try ${msg.retryCount}/${maxRetries} - Error: ${msg.error.message}`);\n\nif (msg.retryCount <= maxRetries) {\n    node.status({fill: \"yellow\", shape: \"ring\", text: `Reintento ${msg.retryCount}`});\n    return [msg, null];\n} else {\n    node.status({fill: \"red\", shape: \"dot\", text: \"Max reintentos\"});\n    \n    msg.payload = {\n        success: false,\n        error: \"Endpoint temporarily unavailable\",\n        message: msg.error.message,\n        attempts: msg.retryCount,\n        timestamp: new Date().toISOString()\n    };\n    msg.statusCode = 503;\n    msg.headers = {\n        \"Content-Type\": \"application/json\",\n        \"Retry-After\": \"60\"\n    };\n    \n    return [null, msg];\n}",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 340,
        "wires": [
            [
                "a4acfb541153ef4d"
            ],
            []
        ]
    },
    {
        "id": "a70b5c6fb5c18947",
        "type": "function",
        "z": "e4c4b244ac7b2ae0",
        "name": "format success",
        "func": "msg.payload = {\n    success: true,\n    data: msg.payload,\n    count: Array.isArray(msg.payload) ? msg.payload.length : 1,\n    timestamp: new Date().toISOString()\n};\n\nmsg.statusCode = 200;\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 940,
        "y": 240,
        "wires": [
            []
        ]
    },
