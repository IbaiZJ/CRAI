    {
        "id": "042666a72dee0b6e",
        "type": "function",
        "z": "a5406ced814d1895",
        "name": "query | ?userId",
        "func": "const userId = (msg.req.query.userId || \"\").trim();\n\nif (userId) {\n    msg.topic = `\n    SELECT v.*, u.*\n    FROM vehicles v\n    JOIN user u ON v.userId = u.id\n    WHERE u.id = ?\n    `;\n    msg.params = [userId];\n}\nelse {\n    msg.topic = `\n    SELECT v.*, u.*\n    FROM vehicles v\n    JOIN user u ON v.userId = u.id\n    `;\n}\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 840,
        "y": 280,
