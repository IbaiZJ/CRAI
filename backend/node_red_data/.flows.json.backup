    {
        "id": "a1f0b1e9d1c00101",
        "type": "http in",
        "z": "3bf36f2bd537dee3",
        "name": "Receive plate from IA",
        "url": "/ai/carPlatee",
        "method": "post",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
