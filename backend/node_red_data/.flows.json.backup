        "name": "HTML template",
        "field": "payload",
        "fieldType": "msg",
        "format": "handlebars",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Aviso Matrícula</title>\n</head>\n<body style=\"margin: 0; padding: 0; display: flex; justify-content: center; align-items: center; min-height: 100vh; font-family: 'Arial Black', sans-serif; background-color: #003366;\">\n\n    <div style=\"background-color: white; padding: 40px 20px 80px 20px; border-radius: 10px; box-shadow: 0 10px 40px rgba(0,0,0,0.5); text-align: center; width: 95%; max-width: 1100px; display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 20px;\">\n\n        <div style=\"margin-bottom: 50px; margin-top: 150px;\">\n            <img src=\"https://i.ibb.co/4ZwX1Jyx/Gemini-Generated-Image-b6wzqcb6wzqcb6wz-removebg-preview.png\" \n                 alt=\"Logo\" \n                 style=\"width: 350px; height: auto;\">\n        </div>\n\n        <h1 style=\"font-size: clamp(28px, 6vw, 55px); color: #000; margin: 0 0 30px 0; text-transform: uppercase; line-height: 1.1;\">\n            SE HA DETECTADO TU MATRÍCULA\n        </h1>\n\n        <div style=\"font-size: clamp(40px, 9vw, 90px); font-weight: bold; color: #000; margin-bottom: 25px; font-family: 'Courier New', Courier, monospace; letter-spacing: 6px; border: 4px solid #000; padding: 10px 40px; border-radius: 8px; background-color: #fcfcfc;\">\n            MATRICULA\n        </div>\n\n        <p style=\"font-size: clamp(18px, 4vw, 28px); color: #333; margin: 0; font-family: Arial, sans-serif; font-weight: normal;\">\n            tu coche tiene la ITV caducada\n        </p>\n\n    </div>\n\n</body>\n</html>",
        "output": "str",
        "x": 1020,
        "y": 560,
        "wires": [
