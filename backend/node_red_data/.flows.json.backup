    {
        "id": "a1f411e0c8b74b4e",
        "type": "comment",
        "z": "a5406ced814d1895",
        "name": "Vehicles API endpoints\\n \\n Routes:\\n - {GET} /vehicles\\n     • Without query: returns all vehicles with their associated user\\n     • ?userId=x: returns vehicles filtered by user\\n \\n - {GET} /vehicle\\n     • ?plate=XXX: returns a vehicle filtered by its plate\\n     • Validates parameters and returns 400 if missing or invalid\\n",
        "info": "Vehicles API endpoints\\n\n\\n\nRoutes:\\n\n- {GET} /vehicles\\n\n    • Without query: returns all vehicles with their associated user\\n\n    • ?userId=x: returns vehicles filtered by user\\n\n\\n\n- {GET} /vehicle\\n\n    • ?plate=XXX: returns a vehicle filtered by its plate\\n\n    • Validates parameters and returns 400 if missing or invalid\\n",
        "x": 300,
        "y": 360,
        "wires": []
    },
    {
        "id": "dcf42b3e5bc3e2af",
        "type": "http in",
        "z": "a5406ced814d1895",
        "name": "{get} /vehicle",
        "url": "/vehicle",
        "method": "get",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 630,
        "y": 360,
        "wires": [
            [
                "057bdb3779df26d7"
            ]
        ]
    },
    {
        "id": "057bdb3779df26d7",
        "type": "function",
        "z": "a5406ced814d1895",
        "name": "query | ?plate",
        "func": "const plate = (msg.req.query.plate || \"\").trim();\n\nif (!plate) {\n    msg.payload = {\n        success: false,\n        error: \"Missing required parameter: plate\"\n    };\n\n    msg.statusCode = 400;\n\n    msg.headers = {\n        \"Content-Type\": \"application/json\"\n    };\n\n    return msg;\n}\n\n\nmsg.topic = `\nSELECT *\nFROM vehicles\nWHERE plate = ?\n`;\nmsg.params = [plate];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 840,
        "y": 360,
        "wires": [
