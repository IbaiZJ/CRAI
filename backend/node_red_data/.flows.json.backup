    {
        "id": "10fe6fc3c782d876",
        "type": "function",
        "z": "202119be2ec9a18d",
        "name": "format final response",
        "func": "const allSuccess = Array.isArray(msg.payload.success) && \n                   msg.payload.success.every(s => s === true);\n\n\nif (allSuccess) {\n    msg.payload = {\n        success: true,\n        carPlate: msg.carPlate,\n        data: {\n            itv: msg.itvAPI,\n            environmentalBadge: msg.ebAPI || null,\n            isStolen: msg.stolen || false\n        },\n        timestamp: new Date().toISOString()\n    };\n    msg.statusCode = 200;\n} else {\n    msg.payload = {\n        success: false,\n        carPlate: msg.carPlate,\n        error: \"Failed\",\n        timestamp: new Date().toISOString()\n    };\n    msg.statusCode = 400;\n}\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1830,
        "y": 140,
